// GeoStreak leaderboard rules — paste into Firebase console -> Firestore
// Database -> Rules -> replace the contents -> Publish. This project has
// no Firebase Hosting / CLI deploy set up, so this file is documentation
// + copy-paste source, not something that deploys itself.
//
// One document per player, keyed by their anonymous-auth uid. The single
// rule that actually matters for cheat-resistance is the bestStreak
// comparison on update — everything else here is shape/bounds validation,
// which stops garbage data but not a determined cheater with devtools
// open. See the README's Leaderboard section for what it would take to
// close that gap for real (short version: judge guesses server-side via
// a Cloud Function, which needs the paid Blaze plan).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /geostreakLeaderboard/{uid} {
      // Public leaderboard — anyone can read the rankings, signed in or not.
      allow read: if true;

      // A player may only ever write their OWN document (their uid is the
      // document id), and only with a shape that passes isValidEntry().
      allow create: if request.auth != null
        && request.auth.uid == uid
        && isValidEntry(request.resource.data);

      // An update additionally has to actually beat the stored streak —
      // this is what stops a losing run's lower number (or a replayed
      // stale write) from clobbering a real personal best.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && isValidEntry(request.resource.data)
        && request.resource.data.bestStreak > resource.data.bestStreak;

      allow delete: if false;
    }

    // Today's leaderboard — one document per player per Central-European
    // calendar day (doc id "{uid}_{date}"), upserted the same
    // improvement-only way as geostreakLeaderboard above. A new day is
    // simply a new doc id, so there's nothing to roll over at midnight —
    // yesterday's doc is just never written to again.
    match /geostreakDaily/{docId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid
        && isValidDailyEntry(request.resource.data);

      allow update: if request.auth != null
        && request.auth.uid == request.resource.data.uid
        && isValidDailyEntry(request.resource.data)
        && request.resource.data.bestStreak > resource.data.bestStreak;

      allow delete: if false;
    }

    // Morning Checklist — a separate personal tool that just happens to
    // share this Firebase project (see checklist/README.md). One document
    // per person per local calendar day (doc id "{uid}_{date}"), fetched
    // directly by id rather than queried, so unlike the two collections
    // above this needs no composite index. Unlike everything else here,
    // updates aren't one-directional — a checked box can be unchecked
    // later the same day — so there's no "must increase" style guard,
    // just ownership and shape.
    match /morningChecklist/{docId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid
        && isValidChecklist(request.resource.data);

      allow update: if request.auth != null
        && request.auth.uid == resource.data.uid
        && request.auth.uid == request.resource.data.uid
        && isValidChecklist(request.resource.data);

      allow delete: if false;
    }

    // Full per-run history (every round's question + guess + result), for
    // the History page's "replay one of my runs" view. One document per
    // completed run, auto-generated id — unlike the leaderboard above,
    // this is written ONCE, at Game Over, and never updated again.
    match /geostreakRuns/{runId} {
      // Private — a player can only read their own run history, never
      // anyone else's, unless they're one of the hardcoded master UIDs
      // below (History page's "All Players" tab). This is real per-round
      // detail, not just a headline number, so (unlike the public
      // leaderboard) there's no reason for it to be world-readable by
      // default.
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || isMaster());

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid
        && isValidRun(request.resource.data);

      // No update path at all — a run is a historical record of what
      // actually happened, not a value that should ever change afterward.
      allow update: if false;
      allow delete: if false;
    }

    // ---- Time Quiz ------------------------------------------------------
    // Same three-collection shape as GeoStreak above (personal-best,
    // personal-best-today, full run log), adapted for a fixed 15-question
    // quiz-and-score game instead of an open-ended streak. Plus two
    // aggregate, world-readable tally collections with no owner at all —
    // every signed-in player increments the same shared handful of
    // documents — backing the "Most Used Cities/Countries" insight on
    // timeQuiz.html's start screen.
    match /timeQuizLeaderboard/{uid} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && isValidTimeQuizEntry(request.resource.data);

      allow update: if request.auth != null
        && request.auth.uid == uid
        && isValidTimeQuizEntry(request.resource.data)
        && request.resource.data.bestScore > resource.data.bestScore;

      allow delete: if false;
    }

    match /timeQuizDaily/{docId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid
        && isValidTimeQuizDailyEntry(request.resource.data);

      allow update: if request.auth != null
        && request.auth.uid == request.resource.data.uid
        && isValidTimeQuizDailyEntry(request.resource.data)
        && request.resource.data.bestScore > resource.data.bestScore;

      allow delete: if false;
    }

    // Full per-question run log, one document per completed quiz — same
    // "private, own-runs-or-master-only, write-once" shape as
    // geostreakRuns above. See historyPage.js's GAMES config for how the
    // History page reads this alongside geostreakRuns.
    match /timeQuizRuns/{runId} {
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || isMaster());

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid
        && isValidTimeQuizRun(request.resource.data);

      allow update: if false;
      allow delete: if false;
    }

    // One document per distinct city ever used as an answer, across every
    // player — doc id is a sanitized "country_city" slug (tallyDocId() in
    // timeQuizLeaderboard.js), not a uid, since this is a shared counter
    // with no single owner. The only thing enforced is "count can only go
    // up, by exactly 1, per write" (mirrors the bestStreak/bestScore
    // improvement-only gates above) plus city/country staying fixed for a
    // given doc id — there's no per-write attribution to police beyond
    // that, same "client-judged" caveat as the rest of this file.
    match /timeQuizCityTally/{docId} {
      allow read: if true;
      allow create: if request.auth != null && isValidCityTallyCreate(request.resource.data);
      allow update: if request.auth != null && isValidCityTallyUpdate(request.resource.data, resource.data);
      allow delete: if false;
    }

    match /timeQuizCountryTally/{docId} {
      allow read: if true;
      allow create: if request.auth != null && isValidCountryTallyCreate(request.resource.data);
      allow update: if request.auth != null && isValidCountryTallyUpdate(request.resource.data, resource.data);
      allow delete: if false;
    }

    // A player's own Time Quiz state — best score, lifetime counters, and
    // progress through the STAGES campaign (timeQuiz.js), keyed by a
    // numeric stageIndex (0 = World, up through the Hemisphere Challenge
    // finale). One private document (own-uid read/write only, no reason
    // for this to be public the way the leaderboard is) that timeQuiz.js
    // fetches once per page load and writes back once per finished quiz —
    // via a full `.set(data)` (no `{merge: true}`), so an older document
    // still carrying the previous version's fields (`regionsUnlocked`,
    // `lastRegions`, from before stages were linear) gets replaced
    // outright rather than merged, which is what actually lets
    // isValidPlayerState()'s hasOnly() keep working for a returning
    // player instead of permanently rejecting every future write. Unlike
    // timeQuizLeaderboard above, this is NOT gated on beating a previous
    // best — it's meant to be written on every single completed quiz,
    // improvement or not, since it's this player's own persistent state,
    // not a ranked comparison against everyone else.
    match /timeQuizPlayers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && isValidPlayerState(request.resource.data);

      // Every field is one-directional — lifetime counters and bestScore
      // only ever go up, and stageIndex can only advance, never retreat —
      // same "can only go up" philosophy as the improvement gates
      // elsewhere in this file, just without requiring bestScore
      // specifically to have improved THIS write. `resource.data.get(...)`
      // rather than plain dot access on `stageIndex` specifically — a
      // pre-migration document has bestScore/totalCorrect/totalAttempts/
      // totalRuns already (those existed before stages existed) but has
      // no `stageIndex` key at all, and reading a genuinely missing map
      // key errors the whole rule out (denying the write, forever, for
      // that player) rather than just being falsy the way it would in JS.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && isValidPlayerState(request.resource.data)
        && request.resource.data.bestScore >= resource.data.bestScore
        && request.resource.data.totalCorrect >= resource.data.totalCorrect
        && request.resource.data.totalAttempts >= resource.data.totalAttempts
        && request.resource.data.totalRuns >= resource.data.totalRuns
        && request.resource.data.stageIndex >= resource.data.get('stageIndex', 0);

      allow delete: if false;
    }
  }

  // History page's "All Players" tab — a hardcoded allowlist, not a
  // Firestore-stored role, since there's no admin UI to manage one and
  // this is a small personal project. Empty by default (matches nobody).
  // Must be kept in sync by hand with MASTER_UIDS in historyPage.js —
  // that copy only controls whether the tab is shown, this one is the
  // real enforcement, so a UID added to one but not the other either
  // shows a tab that 403s (JS updated, rules not yet republished) or
  // grants access with no visible way to use it (rules updated, JS not
  // yet redeployed) — republish/redeploy both together.
  function isMaster() {
    return request.auth != null && request.auth.uid in ['B0N7TfmkrXTaYjB2TBCVOBVtIhM2', 'MsRKlqcPecOBng8SHekRF5YCVFJ3', 'WmoVyIkr2eVCtQHMPwoiTnKWZQp1', 'M9odxs0JSTPAnFuewYOCB2BEPR03'];
  }

  function isValidEntry(data) {
    return data.keys().hasOnly(['nickname', 'bestStreak', 'totalCorrect', 'totalAttempts', 'totalRuns', 'updatedAt'])
      && data.nickname is string && data.nickname.size() > 0 && data.nickname.size() <= 20
      && data.bestStreak is int && data.bestStreak > 0 && data.bestStreak <= 500
      && data.totalCorrect is int && data.totalCorrect >= 0
      && data.totalAttempts is int && data.totalAttempts >= data.totalCorrect
      // totalRuns > 0 since this write only ever happens at the end of a
      // completed run (the one that just set this bestStreak), so there's
      // always at least that one; totalCorrect can't exceed it in
      // principle (one run can bank at most one correct streak-ending
      // guess per round, but a run's correct count and its own count
      // aren't the same axis) — no upper relationship enforced beyond that.
      && data.totalRuns is int && data.totalRuns > 0
      // Rejects a client-supplied timestamp — serverTimestamp() is the
      // only value that resolves to request.time, so this forces the
      // write to actually use it rather than a spoofed date.
      && data.updatedAt == request.time;
  }

  // Same shape as isValidEntry() above, plus `uid` (needed here since the
  // doc id isn't the uid on its own, unlike geostreakLeaderboard) and
  // `date`.
  function isValidDailyEntry(data) {
    return data.keys().hasOnly(['uid', 'nickname', 'bestStreak', 'totalCorrect', 'totalAttempts', 'totalRuns', 'date', 'updatedAt'])
      && data.uid is string
      && data.nickname is string && data.nickname.size() > 0 && data.nickname.size() <= 20
      && data.bestStreak is int && data.bestStreak > 0 && data.bestStreak <= 500
      && data.totalCorrect is int && data.totalCorrect >= 0
      && data.totalAttempts is int && data.totalAttempts >= data.totalCorrect
      && data.totalRuns is int && data.totalRuns > 0
      && data.date is string && data.date.size() == 10
      && data.updatedAt == request.time;
  }

  function isValidChecklist(data) {
    return data.keys().hasOnly(['uid', 'date', 'checked', 'updatedAt'])
      && data.uid is string
      && data.date is string && data.date.size() == 10
      && data.checked is list && data.checked.size() == 7
      && data.updatedAt == request.time;
  }

  // Deliberately shallow: checks the run's own shape and bounds, not every
  // field inside every element of `rounds` — validating each round's inner
  // structure would be a lot of rule code to defend data that's already
  // client-judged same as everything else here (see the top of this file).
  function isValidRun(data) {
    return data.keys().hasOnly(['uid', 'nickname', 'finalStreak', 'reason', 'roundCount', 'rounds', 'playedAt'])
      && data.uid is string
      && data.nickname is string && data.nickname.size() <= 20
      && data.finalStreak is int && data.finalStreak >= 0 && data.finalStreak <= 500
      && data.reason in ['wrong', 'time']
      && data.roundCount is int && data.roundCount >= 0 && data.roundCount <= 2000
      && data.rounds is list && data.rounds.size() == data.roundCount
      && data.playedAt == request.time;
  }

  // Same shape as isValidEntry() above, with bestScore in place of
  // bestStreak — a Time Quiz run's score is 0-15000 (15 questions x 1000
  // points max), not an open-ended streak.
  function isValidTimeQuizEntry(data) {
    return data.keys().hasOnly(['nickname', 'bestScore', 'totalCorrect', 'totalAttempts', 'totalRuns', 'updatedAt'])
      && data.nickname is string && data.nickname.size() > 0 && data.nickname.size() <= 20
      && data.bestScore is int && data.bestScore > 0 && data.bestScore <= 15000
      && data.totalCorrect is int && data.totalCorrect >= 0
      && data.totalAttempts is int && data.totalAttempts >= data.totalCorrect
      && data.totalRuns is int && data.totalRuns > 0
      && data.updatedAt == request.time;
  }

  function isValidTimeQuizDailyEntry(data) {
    return data.keys().hasOnly(['uid', 'nickname', 'bestScore', 'totalCorrect', 'totalAttempts', 'totalRuns', 'date', 'updatedAt'])
      && data.uid is string
      && data.nickname is string && data.nickname.size() > 0 && data.nickname.size() <= 20
      && data.bestScore is int && data.bestScore > 0 && data.bestScore <= 15000
      && data.totalCorrect is int && data.totalCorrect >= 0
      && data.totalAttempts is int && data.totalAttempts >= data.totalCorrect
      && data.totalRuns is int && data.totalRuns > 0
      && data.date is string && data.date.size() == 10
      && data.updatedAt == request.time;
  }

  // Deliberately shallow, same reasoning as isValidRun() above — checks
  // the run's own shape and bounds, not every field inside every element
  // of `rounds`.
  function isValidTimeQuizRun(data) {
    return data.keys().hasOnly(['uid', 'nickname', 'score', 'correctCount', 'questionCount', 'regions', 'rounds', 'playedAt'])
      && data.uid is string
      && data.nickname is string && data.nickname.size() <= 20
      && data.score is int && data.score >= 0 && data.score <= 15000
      && data.correctCount is int && data.correctCount >= 0 && data.correctCount <= 15
      && data.questionCount is int && data.questionCount >= 0 && data.questionCount <= 15
      && data.regions is list && data.regions.size() <= 10
      && data.rounds is list && data.rounds.size() == data.questionCount
      && data.playedAt == request.time;
  }

  // `count == 1` on create — FieldValue.increment(1) against a field that
  // doesn't exist yet resolves to 0 + 1, so this is what a brand-new
  // tally doc's first write always looks like.
  function isValidCityTallyCreate(data) {
    return data.keys().hasOnly(['city', 'country', 'count', 'lastUsedAt'])
      && data.city is string && data.city.size() > 0 && data.city.size() <= 100
      && data.country is string && data.country.size() == 2
      && data.count is int && data.count == 1
      && data.lastUsedAt == request.time;
  }

  // `city`/`country` pinned to whatever the doc was created with — the
  // doc id already encodes both, so this just stops a mismatched write
  // (a hand-crafted request reusing someone else's doc id) from quietly
  // relabeling an existing tally. `count` may only go up by exactly 1.
  function isValidCityTallyUpdate(data, existing) {
    return data.keys().hasOnly(['city', 'country', 'count', 'lastUsedAt'])
      && data.city == existing.city
      && data.country == existing.country
      && data.count is int && data.count == existing.count + 1
      && data.lastUsedAt == request.time;
  }

  function isValidCountryTallyCreate(data) {
    return data.keys().hasOnly(['country', 'count', 'lastUsedAt'])
      && data.country is string && data.country.size() == 2
      && data.count is int && data.count == 1
      && data.lastUsedAt == request.time;
  }

  function isValidCountryTallyUpdate(data, existing) {
    return data.keys().hasOnly(['country', 'count', 'lastUsedAt'])
      && data.country == existing.country
      && data.count is int && data.count == existing.count + 1
      && data.lastUsedAt == request.time;
  }

  // `stageIndex` isn't checked against the actual STAGES array (that
  // lives in timeQuiz.js, not here) beyond a generous upper bound — same
  // "shape/bounds only" shallowness as isValidRun() and
  // isValidTimeQuizRun() above. 10 is comfortably above STAGES.length
  // today (6) so a future stage or two can be added without a rules
  // change; it's a sanity ceiling, not meant to track the real count.
  function isValidPlayerState(data) {
    return data.keys().hasOnly(['bestScore', 'totalCorrect', 'totalAttempts', 'totalRuns', 'stageIndex', 'updatedAt'])
      && data.bestScore is int && data.bestScore >= 0 && data.bestScore <= 15000
      && data.totalCorrect is int && data.totalCorrect >= 0
      && data.totalAttempts is int && data.totalAttempts >= data.totalCorrect
      && data.totalRuns is int && data.totalRuns >= 0
      && data.stageIndex is int && data.stageIndex >= 0 && data.stageIndex <= 10
      && data.updatedAt == request.time;
  }
}
